# Copy to .env for local development. .env is gitignored.
# Vite bakes every VITE_* value into the browser bundle.
# Never put a service-role key, database password, or cron secret in a VITE_* variable.
# Never commit a real key. The legacy Lovable project is not reused.

# --- Public, safe to expose to the browser (GitHub environment variables) ---

# https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase project ref. Replace supabase/config.toml project_id when the owner creates the project.
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Supabase anon / publishable key. Public by design. Still do not commit a real value.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY

# Cloudflare Turnstile site key (public). The secret stays in Supabase Auth, not here.
VITE_TURNSTILE_SITE_KEY=

# Staging keeps password reset hidden until a free single-sender SMTP is approved.
VITE_PASSWORD_RESET_ENABLED=false

# Do not put a live OpenWeather key here. The weather function reads OPENWEATHER_API_KEY
# from Supabase secrets. Leave this blank so the page does not call OpenWeather from the browser.
VITE_OPENWEATHER_API_KEY=

# --- Server-side only. Do not put these in the frontend bundle. ---
# Names the owner must create. Values stay in GitHub environment secrets or Supabase.
#
# GitHub environment secrets (staging, and later production with required reviewers):
#   SUPABASE_ACCESS_TOKEN
#   SUPABASE_DB_PASSWORD
#
# Supabase secrets (supabase secrets set), never committed:
#   OPENWEATHER_API_KEY
#   CRON_SECRET
#
# Supabase Vault (vault.create_secret), never committed:
#   github_dispatch_token
#   functions_base_url
#   cron_secret
#   rebuild_dispatch_url   # optional, later Cloudflare deploy hook
#
# Supabase Auth dashboard, not an env file:
#   Turnstile secret key
#
# Injected into Edge Functions by the platform at runtime. Do not copy it into git:
#   SUPABASE_SERVICE_ROLE_KEY
