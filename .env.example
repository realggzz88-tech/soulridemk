# Copy to .env for local development. .env is gitignored.
# These values are baked into the browser bundle. Use the Supabase anon/publishable key only.
# Never put the service-role key in VITE_* variables.

# https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase project ref (also recorded in supabase/config.toml for the CLI)
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Supabase anon key (public in the browser; still do not commit a real value)
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY

# Optional. Leave blank to show a local weather estimate instead of live OpenWeather data.
# A server-side proxy is the intended follow-up so this key is not shipped to browsers.
VITE_OPENWEATHER_API_KEY=

# Catalog source. `static` reads src/data (the default). `supabase` reads the planned
# Free-tier content tables (spots, routes, route_spots, photos, spot_photos) with the
# anon key above. It stays off unless this is exactly `supabase` and both Supabase
# vars are set. Do not put a service-role key here. No image transforms.
VITE_CONTENT_SOURCE=static
